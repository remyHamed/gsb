{% extends 'base.html.twig' %}

{% block title %}Employee{% endblock %}

{% block body %}
    <h1>Employee</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ employee.id }}</td>
            </tr>
            <tr>
                <th>FirstName</th>
                <td>{{ employee.firstName }}</td>
            </tr>
            <tr>
                <th>LastName</th>
                <td>{{ employee.lastName }}</td>
            </tr>
            <tr>
                <th>DateAnciennete</th>
                <td>{{ employee.dateAnciennete ? employee.dateAnciennete|date('Y-m-d') : '' }}</td>
            </tr>
            <tr>
                <th>WeeklyHours</th>
                <td>{{ employee.weeklyHours }}</td>
            </tr>
            <tr>
                <th>AvailableSlots</th>
                <td>{{ employee.availableSlots ? employee.availableSlots|json_encode : '' }}</td>
            </tr>
            <tr>
                <th>DatesExclues</th>
                <td>{{ employee.datesExclues ? employee.datesExclues|json_encode : '' }}</td>
            </tr>
            <tr>
                <th>Skills</th>
                <td>{{ employee.skills ? employee.skills|json_encode : '' }}</td>
            </tr>
            <tr>
                <th>IsActive</th>
                <td>{{ employee.isActive ? 'Yes' : 'No' }}</td>
            </tr>
            <tr>
                <th>CreatedAt</th>
                <td>{{ employee.createdAt ? employee.createdAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_employee_index') }}">back to list</a>

    <a href="{{ path('app_employee_edit', {'id': employee.id}) }}">edit</a>

    {{ include('employee/_delete_form.html.twig') }}
{% endblock %}
