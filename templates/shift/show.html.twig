{% extends 'base.html.twig' %}

{% block title %}Shift{% endblock %}

{% block body %}
    <h1>Shift</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ shift.id }}</td>
            </tr>
            <tr>
                <th>Date</th>
                <td>{{ shift.date ? shift.date|date('Y-m-d') : '' }}</td>
            </tr>
            <tr>
                <th>StartTime</th>
                <td>{{ shift.startTime }}</td>
            </tr>
            <tr>
                <th>EndTime</th>
                <td>{{ shift.endTime }}</td>
            </tr>
            <tr>
                <th>SkillsRequired</th>
                <td>{{ shift.skillsRequired ? shift.skillsRequired|json_encode : '' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_shift_index') }}">back to list</a>

    <a href="{{ path('app_shift_edit', {'id': shift.id}) }}">edit</a>

    {{ include('shift/_delete_form.html.twig') }}
{% endblock %}
